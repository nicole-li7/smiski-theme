  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#737b64", "fontStyle": "italic" }
    },
    {
      "name": "Doc comment tags",
      "scope": ["comment keyword", "comment storage.type", "comment entity.name.type", "comment variable"],
      "settings": { "foreground": "#8a9276", "fontStyle": "italic" }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "keyword.control", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python", "keyword.other.using", "keyword.other.import", "keyword.other.package", "keyword.other.namespace"],
      "settings": { "foreground": "#c5cf8f" }
    },
    {
      "name": "Storage (let, const, class, static, public)",
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#c5cf8f" }
    },
    {
      "name": "Storage type in function/arrow",
      "scope": ["storage.type.function.arrow"],
      "settings": { "foreground": "#9ea58c" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "keyword.operator.assignment", "keyword.operator.arithmetic", "keyword.operator.comparison", "keyword.operator.logical"],
      "settings": { "foreground": "#9ea58c" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator", "punctuation.definition.parameters", "punctuation.definition.block"],
      "settings": { "foreground": "#9ea58c" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": { "foreground": "#a8c48a" }
    },
    {
      "name": "String escapes and regex",
      "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder", "string.regexp punctuation.definition.string"],
      "settings": { "foreground": "#bdd3a3" }
    },
    {
      "name": "Template expression punctuation",
      "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded", "punctuation.section.interpolation"],
