  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#a2868d",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tags",
      "scope": [
        "comment keyword",
        "comment storage.type",
        "comment entity.name.type",
        "comment variable"
      ],
      "settings": {
        "foreground": "#a98d94",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.other.using",
        "keyword.other.import",
        "keyword.other.package",
        "keyword.other.namespace"
      ],
      "settings": {
        "foreground": "#e79ab0"
      }
    },
    {
      "name": "Storage (let, const, class, static, public)",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#e79ab0"
      }
    },
    {
      "name": "Storage type in function/arrow",
      "scope": [
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#c2a8ae"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#c2a8ae"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
