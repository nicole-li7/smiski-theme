  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#7f6968",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tags",
      "scope": [
        "comment keyword",
        "comment storage.type",
        "comment entity.name.type",
        "comment variable"
      ],
      "settings": {
        "foreground": "#8e7674",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.other.using",
        "keyword.other.import",
        "keyword.other.package",
        "keyword.other.namespace"
      ],
      "settings": {
        "foreground": "#b0476b"
      }
    },
    {
      "name": "Storage (let, const, class, static, public)",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#b0476b"
      }
    },
    {
      "name": "Storage type in function/arrow",
      "scope": [
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#705957"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#705957"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
